---
import '@fontsource-variable/montserrat';
import '../styles/site.css';
import '../styles/extras.css';
import headerHtml from '../site/header.html?raw';
import footerHtml from '../site/footer.html?raw';
import { header, shorten, withBase } from '../lib/page';
import { url } from '../lib/url';

interface Props {
  /** Page title; the site name is appended. Omit on the front page. */
  title?: string;
  description?: string;
  /** "byvaro" switches the page to the Byvaro look. */
  theme?: 'ba' | 'byvaro';
  /** The page's main content as exported from the mockup (src/site/*.html). Without it, the slot is used. */
  html?: string;
  /** Exclude from search engines (used by the 404 page). */
  noindex?: boolean;
}

const siteName = 'BA';
const { title, description = '', theme = 'ba', html, noindex = false } = Astro.props;
const fullTitle = title ? `${title} – ${siteName}` : `${siteName} – brolægning, anlæg, beton og mandskab på Sjælland`;
const summary = shorten(description);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(url('/og-image.png'), Astro.site).href;
const path = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length) || '/';
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {summary && <meta name="description" content={summary} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title ?? siteName} />
    {summary && <meta property="og:description" content={summary} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#indhold">Spring til indhold</a>
    <div id="site" data-site={theme}>
      <Fragment set:html={header(theme === 'byvaro' ? headerHtml.replace('BA_logo_primaer.svg', 'BA_logo_negativ.svg') : headerHtml, path)} />
      {
        html ? (
          <main id="indhold" tabindex="-1" set:html={withBase(html)} />
        ) : (
          <main id="indhold" tabindex="-1">
            <slot />
          </main>
        )
      }
      <Fragment set:html={withBase(footerHtml)} />
    </div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 100;
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
    font-weight: var(--weight-semibold);
    transform: translateY(-200%);
  }
  .skip-link:focus { transform: none; }
  main:focus { outline: none; }
</style>
