---
import { Picture } from 'astro:assets';
import { getProjectCompanies, joinDa, type Project } from '../lib/content';
import { url } from '../lib/url';

interface Props {
  project: Project;
  /** Heading level inside the surrounding section. */
  headingLevel?: 'h2' | 'h3';
  /** Load eagerly (only for cards visible on first paint). */
  eager?: boolean;
}

const { project, headingLevel: Heading = 'h3', eager = false } = Astro.props;
const { title, location, year, type, photos } = project.data;
const companies = await getProjectCompanies(project);
const cover = photos[0];
---

<article
  class="project-card"
  data-companies={companies.map((c) => c.id).join(' ')}
  data-type={type}
>
  <Picture
    src={cover.src}
    alt=""
    formats={['avif', 'webp']}
    widths={[480, 800, 1200]}
    sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
    loading={eager ? 'eager' : 'lazy'}
    class="project-card__img"
  />
  <div class="project-card__body">
    <p class="project-card__meta">{type} · {year}</p>
    <Heading class="project-card__title">
      <a href={url(`/projekter/${project.id}/`)}>{title}</a>
    </Heading>
    <p class="project-card__sub">{location} · {joinDa(companies.map((c) => c.data.name))}</p>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
  }
  .project-card :global(.project-card__img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .project-card__body { padding: var(--space-4) 0 var(--space-2); }
  .project-card__meta {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
  }
  .project-card__title { margin: 0 0 var(--space-2); font-size: var(--text-xl); }
  .project-card__title a { color: var(--color-text); text-decoration: none; }
  /* Whole card is clickable; the link text stays just the title. */
  .project-card__title a::after { content: ""; position: absolute; inset: 0; }
  .project-card:hover .project-card__title a { text-decoration: underline; text-decoration-color: var(--color-accent); }
  .project-card:focus-within { outline: 3px solid var(--color-focus); outline-offset: 4px; }
  .project-card__title a:focus-visible { outline: none; }
  .project-card__sub { margin: 0; color: var(--color-text-muted); }
</style>
