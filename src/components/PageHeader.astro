---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<header class="page-header">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="rule">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    padding-block: var(--space-16) var(--space-12);
    background: var(--color-bg-muted);
  }
  .page-header h1 { font-size: var(--text-display); margin-bottom: var(--space-6); }
</style>
