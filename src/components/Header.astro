---
import Logo from './Logo.astro';
import { nav } from '../data/site';
import { url } from '../lib/url';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(url(href));
---

<header class="header">
  <div class="container header__inner">
    <a href={url('/')} class="header__home">
      <Logo height={36} alt="BA Group – til forsiden" />
    </a>
    <nav aria-label="Hovedmenu">
      <ul class="header__nav">
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-8);
    padding-block: var(--space-4);
  }
  /* Clear space around the logo: ¼ of its height */
  .header__home { display: block; padding: 9px 0; }
  /* No JS menu: links wrap on narrow screens. */
  .header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .header__nav a {
    position: relative;
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }
  /* Underline draws from the left – a small echo of the red line. */
  .header__nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--color-border);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .header__nav a:hover::after { transform: scaleX(1); }
  .header__nav a[aria-current='page']::after { background: var(--color-accent); transform: scaleX(1); }
  @media (max-width: 30rem) {
    .header__nav { gap: var(--space-1) var(--space-4); font-size: 0.9375rem; }
  }
</style>
