---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projectTypes } from '../../data/site';
import { getCompanies, getProjects } from '../../lib/content';

const projects = await getProjects();
const companies = await getCompanies();
// Only offer filter values that actually have projects.
const usedTypes = projectTypes.filter((t) => projects.some((p) => p.data.type === t));
const usedCompanies = companies.filter((c) => projects.some((p) => p.data.companies.some((ref) => ref.id === c.id)));
---

<Base title="Projekter" description="Udvalgte projekter fra virksomhederne i BA Group.">
  <PageHeader eyebrow="Projekter" title="Det har vi bygget" lead="Pladsholder: Kort intro til projektoversigten." />

  <section class="section" aria-label="Projektoversigt">
    <div class="container">
      <!-- Revealed by the script below; without JS every project is simply listed. -->
      <div class="filters" data-filters hidden>
        <div class="filters__field">
          <label for="filter-company">Virksomhed</label>
          <select id="filter-company" data-filter="virksomhed">
            <option value="">Alle virksomheder</option>
            {usedCompanies.map((c) => <option value={c.id}>{c.data.name}</option>)}
          </select>
        </div>
        <div class="filters__field">
          <label for="filter-type">Type</label>
          <select id="filter-type" data-filter="type">
            <option value="">Alle typer</option>
            {usedTypes.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>
        <p class="filters__status" role="status" data-status></p>
      </div>

      <div class="grid grid--3" data-projects>
        {projects.map((project, i) => <ProjectCard project={project} headingLevel="h2" eager={i < 3} />)}
      </div>
      <p class="empty" data-empty hidden>Ingen projekter matcher dit valg.</p>
    </div>
  </section>
</Base>

<script>
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const selects = [...document.querySelectorAll<HTMLSelectElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-projects] > [data-type]')];
  const status = document.querySelector<HTMLElement>('[data-status]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  if (filters && status && empty) {
    const params = new URLSearchParams(location.search);
    for (const select of selects) {
      const value = params.get(select.dataset.filter!);
      if (value && [...select.options].some((o) => o.value === value)) select.value = value;
    }

    const apply = (announce: boolean) => {
      const [company, type] = selects.map((s) => s.value);
      let shown = 0;
      for (const card of cards) {
        const match =
          (!company || card.dataset.companies!.split(' ').includes(company)) && (!type || card.dataset.type === type);
        card.hidden = !match;
        if (match) shown++;
      }
      empty.hidden = shown > 0;
      if (announce) status.textContent = `Viser ${shown} ${shown === 1 ? 'projekt' : 'projekter'}`;

      const next = new URLSearchParams();
      for (const select of selects) if (select.value) next.set(select.dataset.filter!, select.value);
      const query = next.toString();
      history.replaceState(null, '', query ? `?${query}` : location.pathname);
    };

    for (const select of selects) select.addEventListener('change', () => apply(true));
    filters.hidden = false;
    apply(false);
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-4) var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .filters__field { display: grid; gap: var(--space-1); }
  .filters label { font-size: var(--text-sm); font-weight: var(--weight-semibold); }
  .filters select {
    min-width: 14rem;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--ba-grey-dark);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }
  .filters__status { margin: 0 0 var(--space-3); color: var(--color-text-muted); }
  .empty { margin-top: var(--space-8); }
</style>
