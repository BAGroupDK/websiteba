---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CompanyCard from '../components/CompanyCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { keyFigures, site, timeline } from '../data/site';
import { getCompanies, getFeaturedProjects } from '../lib/content';
import { url } from '../lib/url';
import hero from '../assets/images/hero-placeholder.jpg';

const companies = await getCompanies();
const featured = await getFeaturedProjects(3);
---

<Base>
  <section class="hero on-photo" aria-labelledby="hero-title">
    <Picture
      src={hero}
      alt=""
      formats={['avif', 'webp']}
      widths={[800, 1400, 2000, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero__img"
    />
    <div class="container hero__content">
      <p class="eyebrow hero__eyebrow">{site.name}</p>
      <h1 id="hero-title" class="hero__title">Pladsholder: Ét stærkt budskab om koncernen</h1>
      <p class="hero__lead">Pladsholder: En sætning der uddyber budskabet – hvem vi er, og hvad vi bygger.</p>
      <div class="hero__actions">
        <a class="button" href={url('/projekter/')}>Se vores projekter</a>
        <a class="button button--ghost" href={url('/kontakt/')}>Kontakt os</a>
      </div>
    </div>
  </section>

  <section class="section--inverse figures" aria-label="Nøgletal">
    <dl class="container figures__list">
      {
        keyFigures.map((f) => (
          <div class="figures__item">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section section--muted" aria-labelledby="companies-title">
    <div class="container">
      <p class="eyebrow">Koncernen</p>
      <h2 id="companies-title" class="rule">Virksomhederne i {site.name}</h2>
      <div class="grid grid--3">
        {companies.map((company) => <CompanyCard company={company} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Udvalgte projekter</p>
          <h2 id="projects-title" class="rule">Det har vi bygget</h2>
        </div>
        <a class="button button--ghost" href={url('/projekter/')}>Alle projekter</a>
      </div>
      <div class="grid grid--3">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section section--muted" aria-labelledby="history-title">
    <div class="container history">
      <div>
        <p class="eyebrow">Historien</p>
        <h2 id="history-title" class="rule">Pladsholder: Overskrift om historien</h2>
        <p class="lead">Pladsholder: Kort om koncernens historie i to-tre sætninger.</p>
        <a href={url('/om-os/')}>Læs mere om os</a>
      </div>
      <ol class="history__list">
        {
          timeline.slice(0, 3).map((item) => (
            <li>
              <span class="history__year">{item.year}</span>
              <span>{item.title}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--inverse" aria-labelledby="contact-title">
    <div class="container contact">
      <div>
        <p class="eyebrow">Kontakt</p>
        <h2 id="contact-title" class="rule">Har du et projekt?</h2>
        <p class="lead">Pladsholder: Én sætning om, hvem man kontakter, og hvad der sker bagefter.</p>
      </div>
      <ul class="contact__list">
        <li><a href={`tel:${site.phone.href}`}>{site.phone.display}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: min(85vh, 50rem);
    align-items: end;
    color: var(--color-text-inverse);
    background: var(--color-bg-inverse);
  }
  .hero :global(.hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Darken the photo so white text always passes contrast. */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(19 19 19 / 0.9) 0%, rgb(19 19 19 / 0.55) 55%, rgb(19 19 19 / 0.25) 100%);
  }
  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: var(--space-16);
  }
  .hero__eyebrow { color: var(--ba-grey-light); }
  .hero__title { max-width: 18ch; font-size: var(--text-display); }
  .hero__lead { max-width: 50ch; font-size: var(--text-lg); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-8); }

  .figures { padding-block: var(--space-12); }
  .figures__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-8);
    margin-block: 0;
  }
  .figures__item { display: flex; flex-direction: column-reverse; gap: var(--space-2); }
  .figures__item dd {
    margin: 0;
    font-size: var(--text-3xl);
    font-weight: var(--weight-extrabold);
    line-height: 1;
  }
  .figures__item dt { color: var(--ba-grey-light); }

  .history { display: grid; gap: var(--space-12); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .history__list { margin: 0; padding: 0; list-style: none; border-left: 2px solid var(--color-border); }
  .history__list li { position: relative; display: grid; gap: var(--space-1); padding: 0 0 var(--space-8) var(--space-8); }
  .history__list li::before {
    content: "";
    position: absolute;
    left: -7px;
    top: 0.35em;
    width: 12px;
    height: 12px;
    background: var(--color-accent);
  }
  .history__year { font-weight: var(--weight-extrabold); font-size: var(--text-xl); }

  .contact { display: grid; gap: var(--space-8); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); align-items: end; }
  .contact__list { margin: 0; padding: 0; list-style: none; font-size: var(--text-2xl); font-weight: var(--weight-extrabold); }
  .contact__list a { text-decoration: none; overflow-wrap: anywhere; }
  .contact__list a:hover { text-decoration: underline; text-decoration-color: var(--color-accent); }
</style>
